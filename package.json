{
  "name": "browserstack-business-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Business-ready Playwright test starter for BrowserStack Automate",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "uuid": "11.1.1"
  },
  "scripts": {
    "config:browserstack": "node scripts/configure-browserstack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browserstack": "browserstack-node-sdk playwright test",
    "test:config": "node --test tests/config/*.test.mjs",
    "test:list": "playwright test --list",
    "test:local": "playwright test",
    "test:regression": "playwright test --grep @regression",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:config && npm run test:list && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "browserstack-node-sdk": "1.68.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
