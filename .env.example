# Target application. Use a public URL when browserstackLocal is false.
APP_BASE_URL=https://cms.demo.katalon.com
WOOCOMMERCE_PRODUCT_PATH=/product/flying-ninja/
WOOCOMMERCE_PRODUCT_NAME=Flying Ninja

# Optional regular expression used by the smoke test.
EXPECTED_TITLE_PATTERN=Katalon|WooCommerce

# Never commit real credentials. Copy this file to .env only for reference;
# export credentials in your shell or store them as GitHub Actions secrets.
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key
